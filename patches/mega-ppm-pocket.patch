+            // pair is the difference between "the game rerouted around it" and
+            // "our rewrite did".
+            u8 prev = 0xFF;
+            for (u16 j = 0; j < PPM_SAT_ENTRIES; j++) {
+                if (evt_link[j] == (u8) i) {
+                    prev = (u8) j;
+                    break;
+                }
+            }
+            evt_put(evt_frame, (u8) i, prev,
+                    prev == 0xFF ? 0xFF
