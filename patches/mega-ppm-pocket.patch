+                    (u8) (flags | (is ? EVT_F_JOINED : 0)),
+                    ppmio.ramdp->sat_data[i].attrs & 0x7ff);
+        }
+    }
+
+    for (u8 i = 0; i < sizeof(cur); i++) {
+        evt_map[i] = cur[i];
+    }
+    for (u16 i = 0; i < PPM_SAT_ENTRIES; i++) {
+        evt_link[i] = ppmio.ramdp->sat_data[i].sizeNext & 0xff;
+    }
+    evt_armed = 1;
+    evt_frame++;
+}
