+static u8  evt_map[(PPM_SAT_ENTRIES + 7) / 8];       // reachable last frame
+static u8  evt_link[PPM_SAT_ENTRIES];                // each node's link last frame
+static u8  evt_buf[EVT_CAP * 8];
