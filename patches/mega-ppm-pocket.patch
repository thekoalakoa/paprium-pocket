+    memcpy(&b[8], &ppmio.ramdp->sat_data[0], 80 * 8);
+    memcpy(&b[8 + 640], &ppmio.ramdp->obj_data[0], 64 * 16);
+    memcpy(&b[8 + 640 + 1024], snap_owner, 80);      // 0xF88..0xFD7, fits the 1792
