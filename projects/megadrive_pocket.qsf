# ==============================================================================
# Quartus Prime Settings File
# ==============================================================================
# WARNING: DO NOT ADD FILES TO THE PROJECT VIA THE QUARTUS IDE!
# The IDE rewrites this file and drops the source line below. Add core sources to
# rtl/core.qip, Pocket shell sources to target/pocket/core.qip.
#
# Adapted from agg23/openfpga-NES projects/nes_pocket.qsf, not from
# open-fpga/core-template src/fpga/ap_core.qsf: that one is 306 lines of IDE-written
# pin assignments with the source list mixed in, which is what the warning above is
# about. The pin-out lives in platform/pocket/pocket.tcl and sources come in through
# the two .qip files.
# ==============================================================================

# ==============================================================================
# Project-Wide Assignments
# ==============================================================================
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 18.1.1
set_global_assignment -name LAST_QUARTUS_VERSION "21.1.1 Lite Edition"
set_global_assignment -name TOP_LEVEL_ENTITY apf_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top

# ==============================================================================
# Compiler Assignments
# ==============================================================================
# The first fitting run used area settings and landed at 82% ALM, so there is
# room to spend on Fmax. Trading it back: speed synthesis plus the physical
# synthesis passes that were previously off because each one costs ALMs.
set_global_assignment -name OPTIMIZATION_MODE "AGGRESSIVE AREA"

# ==============================================================================
# Analysis & Synthesis Assignments
# ==============================================================================
# pocket: agg23's list, reordered and extended for a gate-level console
# model. md_board.v derives VCLK/ZCLK/EDCLK combinationally and ym7101 carries a
# dozen internal phases, so without gated clock conversion the fitter burns clock
# resources this device does not have; the recognition and state machine settings
# push the 68000 microcode PLAs and the VDP state into M10K instead of ALMs, which
# is the difference between fitting and not on a 5CEBA4.
set_global_assignment -name OPTIMIZATION_TECHNIQUE AREA
set_global_assignment -name SYNTH_PROTECT_SDC_CONSTRAINT ON
set_global_assignment -name SYNTH_GATED_CLOCK_CONVERSION ON
set_global_assignment -name AUTO_RESOURCE_SHARING ON
set_global_assignment -name MUX_RESTRUCTURE ON
set_global_assignment -name REMOVE_REDUNDANT_LOGIC_CELLS ON
set_global_assignment -name AUTO_RAM_RECOGNITION ON
set_global_assignment -name AUTO_ROM_RECOGNITION ON
set_global_assignment -name ALLOW_ANY_RAM_SIZE_FOR_RECOGNITION ON
set_global_assignment -name ALLOW_ANY_ROM_SIZE_FOR_RECOGNITION ON
set_global_assignment -name ALLOW_ANY_SHIFT_REGISTER_SIZE_FOR_RECOGNITION ON
set_global_assignment -name AUTO_SHIFT_REGISTER_RECOGNITION ALWAYS
set_global_assignment -name ADV_NETLIST_OPT_SYNTH_WYSIWYG_REMAP ON
set_global_assignment -name PRE_MAPPING_RESYNTHESIS ON
set_global_assignment -name SAFE_STATE_MACHINE OFF
set_global_assignment -name STATE_MACHINE_PROCESSING "MINIMAL BITS"
# pocket-end

# ==============================================================================
# Fitter Assignments
# ==============================================================================
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name STRATIXV_CONFIGURATION_SCHEME "PASSIVE SERIAL"
set_global_assignment -name CRC_ERROR_OPEN_DRAIN ON
set_global_assignment -name ACTIVE_SERIAL_CLOCK FREQ_100MHZ
set_global_assignment -name ROUTER_CLOCKING_TOPOLOGY_ANALYSIS ON
set_global_assignment -name PERIPHERY_TO_CORE_PLACEMENT_AND_ROUTING_OPTIMIZATION ON

# ==============================================================================
# Platform/Core Assignments
# ==============================================================================
source ../platform/pocket/pocket.tcl
set_global_assignment -name QIP_FILE ../rtl/core.qip

# paprium: the Paprium cartridge subsystem - NEORV32 MCU, 68000 mailbox, streaming
# window and the cartridge PCM SFX engine
set_global_assignment -name QIP_FILE ../rtl/paprium.qip

# ==============================================================================
# pocket: 68k.v reads its microcode with $readmemb, which resolves relative to the
# project directory, and the tables live in the vendored tree. Nothing else here
# needed one until Paprium arrived
set_global_assignment -name SEARCH_PATH "../rtl/upstream/nuked-md"
# paprium: mcu_core.sv reads the mega-ppm firmware image (mcu.txt) with $readmemh
# the same way, so the Paprium directory needs the same treatment
set_global_assignment -name SEARCH_PATH ../rtl/PAPRIUM

# The H32/H40 dot clock mux is a LUT with 136 clock loads, the video output registers
# plus the APF data DDIOs. Left on local routing that much skew makes core-to-DDIO hold
# a per-seed coin toss, and the pins are false-pathed so STA would never show it. The
# 90 degree twin gets no such line: its only load is the scal_clk DDIO out in the
# periphery, so the node never reaches the core clock network and the fitter drops the
# assignment as inapplicable
set_instance_assignment -name GLOBAL_SIGNAL "GLOBAL CLOCK" -to ic|clk_vid
# pocket-end

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL

set_parameter -name PAL '0 -entity core_top
set_parameter -name SVP '0 -entity core_top
set_parameter -name PAPRIUM '1 -entity core_top
set_parameter -name PAPRIUM_SFX '1 -entity core_top
set_parameter -name PAPRIUM_CDDA_DBG '0 -entity core_top
set_parameter -name PAPRIUM_CMD_LOG '0 -entity core_top
set_global_assignment -name QII_AUTO_PACKED_REGISTERS "MINIMIZE AREA WITH CHAINS"
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC_FOR_AREA ON
set_global_assignment -name ALM_REGISTER_PACKING_EFFORT HIGH
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"

set_global_assignment -name SEED 9