set_global_assignment -name VHDL_FILE [file join $::quartus(qip_path) "PAPRIUM/risc-v/neorv32_imem.vhd"]
set_global_assignment -name VHDL_FILE [file join $::quartus(qip_path) "PAPRIUM/risc-v/neorv32_dmem.vhd"]
set_global_assignment -name VHDL_FILE [file join $::quartus(qip_path) "PAPRIUM/risc-v/neorv32_boot_rom.vhd"]
set_global_assignment -name VHDL_FILE [file join $::quartus(qip_path) "PAPRIUM/risc-v/neorv32_bootloader_image.vhd"]
set_global_assignment -name VHDL_FILE [file join $::quartus(qip_path) "PAPRIUM/risc-v/neorv32_application_image.vhd"]
