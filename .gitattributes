# The MCU firmware images (scripts/build_mcu.sh writes them; mcu_core.sv and memory.sv $readmemh them) are
# krikzz's bin_to_verilog layout with CRLF line ends. Stored byte for byte, with no line-end conversion, so the
# md5s quoted in scripts/build_mcu.sh and docs/firmware/README.md hold on every platform and checkout setting.
rtl/PAPRIUM/mcu.txt     -text
rtl/PAPRIUM/mcu_ext.txt -text
rtl/PAPRIUM/wram_b0.txt -text
rtl/PAPRIUM/wram_b1.txt -text
rtl/PAPRIUM/wram_b2.txt -text
rtl/PAPRIUM/wram_b3.txt -text
# The fit gate's driver (scripts/gate/run_gate.sh, the checks a fitted seed must pass to be a candidate) runs under
# bash, which refuses CRLF line ends: keep it LF on every checkout.
scripts/gate/*.sh text eol=lf
