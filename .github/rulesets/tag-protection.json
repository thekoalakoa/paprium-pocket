{
  "name": "protect-release-tags",
  "target": "tag",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/tags/*"],
      "exclude": []
    }
  },
  "rules": [
    { "type": "deletion" },
    { "type": "update", "parameters": { "update_allows_fetch_and_merge": false } },
    { "type": "non_fast_forward" }
  ],
  "bypass_actors": [
    { "actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always" }
  ]
}
